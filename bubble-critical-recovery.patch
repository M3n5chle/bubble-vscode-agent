+                success: false,
+                content:
+                    `Die Datei ist mit ${stat.size} Bytes `
+                    + `größer als das Leselimit `
+                    + `von ${MAX_FILE_SIZE} Bytes.`
+            };
+        }
+
+        const data = await vscode.workspace.fs.readFile(fileUri);
