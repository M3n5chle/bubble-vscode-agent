{
  "name": "bubble-vscode-agent",
  "displayName": "Bubble",
  "description": "Lokaler, kontrollierter KI-Assistent für Visual Studio Code mit Ollama-Unterstützung.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bubble-vscode-agent.systemCheck",
        "title": "Bubble: System prüfen"
      },
      {
        "command": "bubble-vscode-agent.ask",
        "title": "Bubble: Frage stellen"
      },
      {
        "command": "bubble-vscode-agent.analyzeProject",
        "title": "Bubble: Projekt analysieren"
      },
      {
        "command": "bubble-vscode-agent.analyzeCurrentFile",
        "title": "Bubble: Aktuelle Datei analysieren"
      },
      {
        "command": "bubble-vscode-agent.analyzeSelectedFiles",
        "title": "Bubble: Ausgewählte Dateien analysieren"
      },
      {
        "command": "bubble-vscode-agent.previewDiff",
        "title": "Bubble: Änderungsvorschau (manueller Text)"
      },
      {
        "command": "bubble-vscode-agent.previewDiffWithAI",
        "title": "Bubble: Änderungsvorschau mit Ollama (nur Diff)"
      },
      {
        "command": "bubble-vscode-agent.planChange",
        "title": "Bubble: Änderung planen"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p ./tsconfig.test.json --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:diagnostic": "npm run compile-tests && vscode-test --config .vscode-test.diagnostic.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}