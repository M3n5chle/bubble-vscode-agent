{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bubble testen",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "--user-data-dir=${env:TEMP}/bubble-dev-user-data",
        "${workspaceFolder}/../bubble-test-workspace"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "Bubble bauen"
    }
  ]
}